{
  "name": "infrawiki",
  "version": "0.0.1",
  "description": "Writes and maintains your infrastructure documentation for agents in Open Knowledge Format (OKF)",
  "license": "Elastic-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saba-ch/infrawiki.git"
  },
  "homepage": "https://github.com/saba-ch/infrawiki#readme",
  "bugs": "https://github.com/saba-ch/infrawiki/issues",
  "keywords": [
    "infrastructure",
    "documentation",
    "wiki",
    "okf",
    "open-knowledge-format",
    "aws",
    "agent",
    "llm",
    "cli",
    "knowledge-graph"
  ],
  "files": [
    "src",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "LICENSE.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "type": "module",
  "bin": {
    "infrawiki": "src/index.ts"
  },
  "scripts": {
    "dev": "bun src/index.ts",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.38",
    "@ai-sdk/azure": "^4.0.42",
    "@ai-sdk/google": "^4.0.43",
    "@ai-sdk/openai": "^4.0.41",
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@aws-sdk/client-account": "^3.1110.0",
    "@aws-sdk/client-resource-explorer-2": "^3.1110.0",
    "@aws-sdk/client-sts": "^3.1110.0",
    "@aws-sdk/credential-providers": "^3.1110.0",
    "@smithy/shared-ini-file-loader": "^4.7.0",
    "@vscode/ripgrep": "^1.15.14",
    "ai": "^7.0.64",
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.18",
    "ink-testing-library": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
